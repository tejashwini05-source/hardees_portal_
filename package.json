  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "npm run dev:vercel",
    "dev:vercel": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --run dev:vercel:cli",
